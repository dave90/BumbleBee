{
  "output_folder": "files/ldbc/actual_neo4j",
  "expected_folder": "files/ldbc/expected",
  "input_folder": "files/ldbc/input_neo4j",
  "comparison_config": "duckdb_ldbc.json",
  "result_format": "cypher_plain",
  "previous_comparison": true,
  "defaults": {
    "timeout": 600,
    "commands": ["cypher-shell -a ${NEO4J_URI:-neo4j://localhost:7687} -u ${NEO4J_USER:-neo4j} -p ${NEO4J_PASSWORD:-bumblebee} --format plain -f $file"]
