g_sum(G, S) :- input(G, _), S = #sum{V : input(G, V)}.
g_min(G, M) :- input(G, _), M = #min{V : input(G, V)}.
g_max(G, M) :- input(G, _), M = #max{V : input(G, V)}.
g_count(G, C) :- input(G, _), C = #count{V : input(G, V)}.

